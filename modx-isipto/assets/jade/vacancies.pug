                            .question_section Шаг&nbsp;
                                span 3 из 8
                        .text_status Готово 28%
                        .status_box
                            .status
                                span(style="width: 28%")
                        .body_form
                            .answer-box.d-flex.flex-wrap.justify-content-between.align-items-start(data-simplebar="init")
                                input.input.form-control(type='text', name="Опыт работы в должности инженера ПТО" required)
                            .button_form.d-flex.justify-content-between.align-items-center
                                button.button.prev_form
                                    span Назад
                                button.button.next_form Далее
                    <!-- Вопрос 4 -->
                    .section_form
                        .header_form.d-flex.justify-content-between.align-items-center.flex-wrap
                            .title_section Есть ли опыт работы в программе AutoCAD?
                            .question_section Шаг&nbsp;
                                span 4 из 8
                        .text_status Готово 42%
                        .status_box
                            .status
                                span(style="width: 42%")
                        .body_form
                            .answer-box.d-flex.flex-wrap.justify-content-between.align-items-start(data-simplebar="init")
                                input.input.form-control(type='text', name="Есть ли опыт работы в программе AutoCAD" required)
                            .button_form.d-flex.justify-content-between.align-items-center
                                button.button.prev_form
                                    span Назад
                                button.button.next_form.button_question2 Далее
                    <!-- Вопрос 5 -->
                    .section_form
                        .header_form.d-flex.justify-content-between.align-items-center.flex-wrap
                            .title_section Трудоустроены ли Вы на данный момент?
                            .question_section Шаг&nbsp;
                                span 5 из 8
                        .text_status Готово 56%
                        .status_box
                            .status
                                span(style="width: 56%")
                        .body_form
                            .answer-box.d-flex.flex-wrap.justify-content-between.align-items-start(data-simplebar="init")
                                input.input.form-control(type='text', name="Трудоустроены ли Вы на данный момент" required)
                            .button_form.d-flex.justify-content-between.align-items-center
                                button.button.prev_form
                                    span Назад
                                button.button.next_form Далее
                    <!-- Вопрос 6 -->
                    .section_form
                        .header_form.d-flex.justify-content-between.align-items-center.flex-wrap
                            .title_section В каких разделах строительства Вы себя считаете специалистом?
                            .question_section Шаг&nbsp;
                                span 6 из 8
                        .text_status Готово 73%
                        .status_box
                            .status
                                span(style="width: 73%")
                        .body_form
                            .answer-box.d-flex.flex-wrap.justify-content-between.align-items-start(data-simplebar="init")
                                input.input.form-control(type='text', name="В каких разделах строительства Вы себя считаете специалистом" required)
                            .button_form.d-flex.justify-content-between.align-items-center
                                button.button.prev_form
                                    span Назад
                                button.button.next_form Отправить
                    <!-- Вопрос 7 -->
                    .section_form
                        .header_form.d-flex.justify-content-between.align-items-center.flex-wrap
                            .title_section Ваш номер телефона
                            .question_section Шаг&nbsp;
                                span 7 из 8
                        .text_status Готово 89%
                        .status_box
                            .status
                                span(style="width: 80%;")
                        .body_form
                            .d-flex.flex-wrap.flex-sm-nowrap
                                .answer-box.total-input.d-flex.flex-wrap.justify-content-between.align-items-start
                                    input.input.form-control(type='text' placeholder="Ваше имя", name="Имя" required)
                                .answer-box.total-input.d-flex.flex-wrap.justify-content-between.align-items-start
                                    input.input.form-control(type='text' placeholder="Ваш возраст", name="Возраст" required)
                                .answer-box.total-input.d-flex.flex-wrap.justify-content-between.align-items-start
                                    input.input.form-control(type='tel' placeholder="8 (", name="Телефон" required)


                            .button_form.d-flex.justify-content-between.align-items-center
                                button.button.prev_form
                                    span Назад
                                button.button.next_form.cme-btn(data-ya="zayavka") Отправить
                    <!-- Вопрос 8 -->
                    .section_form
                        .header_form.d-flex.justify-content-between.align-items-center.flex-wrap
                            .title_section Спасибо за заявку!
                        .text_status Готово 100%
                        .status_box
                            .status
                                span(style="width: 100%;")
                        .body_form
                            .answer-box.d-flex.flex-wrap.justify-content-between.align-items-start
                                .text-end
