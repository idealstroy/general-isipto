                            .question_section Шаг&nbsp;
                                span 1 из 8
                        .text_status Готово 0%
                        .status_box
                            .status
                                span
                        .body_form
                            .answer-box.d-flex.flex-wrap.justify-content-between.align-items-start(data-simplebar="init")
                                input.input.form-control(type='text' placeholder="Уфа" name="Город" required)
                            .button_form.d-flex.justify-content-between.align-items-center
                                .div
                                //-button.button.prev_form(disabled="disabled")
                                    span Назад
                                button.button.next_form Далее
                    <!-- Вопрос 2 -->
                    .section_form
                        .header_form.d-flex.justify-content-between.align-items-center.flex-wrap
