                //-form.d-flex.flex-wrap.col-xl-10.col-md-11.col-12
                    //-input.goalMetrika(type='hidden', name='goal', value='zayavka')
                    .block_input
                        label Ваше имя
                        input.input_form.name(type='text', name='fio', value='')
                    .block_input
                        label Телефон
                        input.input_form.phone(type='tel', name='phone', value='')
                    .block_input.d-flex.align-items-end
                        input.input_form.submit_form.cme-btn(type='submit', value='Отправить')
                    .callme-result
                .confid.col-xl-10.col-md-11.col-12 Нажимая кнопку перезвоните мне вы соглашаетесь с условиями <a class="modalbox btn-modal" href="#politikaModal" rel="nofollow">политики конфиденциальности</a> и &nbsp;<a class="modalbox btn-modal" href="#acceptModal" rel="nofollow">обработки персональных данных</a>
            //-.form_box
                form.form_quiz

                    <!-- Вопрос 1 -->
                    .section_form.active
                        .header_form.d-flex.justify-content-between.align-items-center.flex-wrap
