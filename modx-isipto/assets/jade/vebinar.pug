block var
    -var title = "Заголовок" //- нужен для быстрого понимания, какой файл к какому макету относится
    -var inner = false
    -var index = false
    -var ppr = false
    -var type_jobs = false
    -var inner_no_name = false
    -var vacancies = false
    -var techkarty_smety = false
    -var video_script = false
    -var blog = false
    -var about_company = false
    -var assets = "../assets/" //- ../assets/
    -var min = ".min" //- .min
    -var img = assets+"css/img/"
    -var id_object = false
    -var tenders = false
    -var JivoSite = true
    -var form_footer = true
    -var tabcolor = "#000" //- перекрашивание вкладки в мобильных браузерах, Яндекс.Браузере и Vivaldi


doctype html
html(lang="ru")
    block head
        head
            meta(http-equiv="X-UA-Compatible" content="IE=edge")
            meta(name='viewport', content='width=device-width, initial-scale=1, minimum-scale=1')
            meta(charset='utf-8')

            | [[!*id:is=`337`:then=`<link rel="canonical" href="https://obuchenie.isipto.ru" />`:else=`<link rel="canonical" href="https://obuchenie.isipto.ru/[[*alias:ne=``:then=`[[*alias]]`]]/" />`]]


            <meta property="og:url" content="https://obuchenie.isipto.ru/[[*alias:ne=``:then=`[[*alias]]/`]]/" />

            if inner_no_name
                title [[*seotitle:empty=`[[*longtitle]]`]]

            if inner
                title [[*seotitle:is=``:then=`[[*longtitle]]`:else=`[[*seotitle]]`]]
            else
                title [[*seotitle:is=``:then=`[[*longtitle]]`:else=`[[*seotitle]]`]]

            base(href="[[++site_url]]")
            //-<link rel="canonical" href="[[*canonical:is=``:then=`[[~[[*id]]? &scheme=`full`]]`:else=`[[*canonical]]`]]" />
            <meta property="og:locale" content="ru_RU" />
            <meta property="og:type" content="[[*og_type]]" />
            <meta property="og:title" content="[[*og_title]]" />
            <meta property="og:description" content="[[*og_description]]" />
            | [[*og_site_name:ne=``:then=`<meta property="og:site_name" content="[[*og_site_name]]" />`:else=`<meta property="og:site_name" content="[[++site_name]]" />`]]

            meta(name='description', content='[[*seodescription:empty=`[[*longtitle]]`]]')
            meta(name='keywords', content='[[*seokeywords]]')
            meta(property='og:image', content='[[++site_url]]assets/css/img/ogimage.png')
            meta(name="theme-color" content=tabcolor)
            <meta name="yandex-verification" content="ac43b6d0dd7f3ea9" />

            <style>
            |    @import url('https://fonts.googleapis.com/css?family=Open+Sans:400,600,700,800&display=swap&subset=cyrillic');
            </style>
            link(rel="stylesheet" type="text/css" href="https://obuchenie.isipto.ru/assets/css/style.css?v=7.0000000021")

            if JivoSite
                |    [[!MinifyX?
                |        &minifyJs=`1`
                |        &jsTpl=`<script src="[[+file]]" defer></script>`
                |        &jsSources=`fancybox.js,cookie.js,script.js,svgxuse.js,observer.js,maskedinput.js`
                |    ]]
            else
                |    [[!MinifyX?
                |        &minifyJs=`1`
                |        &jsTpl=`<script src="[[+file]]" defer></script>`
                |        &jsSources=`fancybox.js,cookie.js,script.js,svgxuse.js,observer.js,maskedinput.js,externals-no-jivosite.js`
                |    ]]

block append var
    -var video_script = true
    -var JivoSite = false
    -var form_footer = false
    -var vebinar = true
