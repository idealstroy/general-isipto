doctype html
html(lang="ru")
    block head
        head
            meta(http-equiv="X-UA-Compatible" content="IE=edge")
            meta(name='viewport', content='width=device-width, initial-scale=1, minimum-scale=1')
            meta(charset='utf-8')

            if index_main
                | [[*canonical:ne=``:then=`<link rel="canonical" href="[[*canonical]]" />`:else=`<link rel="canonical" href="https://isipto.ru[[++site_url]]" />`]]
                | [[*og_url:ne=``:then=`<meta property="og:url" content="[[*og_url]]" />`:else=`<meta property="og:url" content="https://isipto.ru[[++site_url]]" />`]]
            else
                | [[*canonical:ne=``:then=`<link rel="canonical" href="[[*canonical]]" />`:else=`<link rel="canonical" href="https://isipto.ru[[++site_url]][[~[[*id]]]]" />`]]
                | [[*og_url:ne=``:then=`<meta property="og:url" content="[[*og_url]]" />`:else=`<meta property="og:url" content="https://isipto.ru[[++site_url]][[~[[*id]]]]" />`]]

            if inner_no_name
                title [[*seotitle:empty=`[[*longtitle]]`]]

            if inner
                title [[*seotitle:is=``:then=`[[*longtitle]]`:else=`[[*seotitle]]`]]
            else
                title [[*seotitle:is=``:then=`[[*longtitle]]`:else=`[[*seotitle]]`]]

            base(href="[[++site_url]]")

            <meta property="og:locale" content="ru_RU" />
            <meta property="og:type" content="[[*og_type]]" />
            <meta property="og:title" content="[[*og_title]]" />
            <meta property="og:description" content="[[*og_description]]" />
            <meta name="robots" content="index, follow">
            | [[*og_site_name:ne=``:then=`<meta property="og:site_name" content="[[*og_site_name]]" />`:else=`<meta property="og:site_name" content="[[++site_name]]" />`]]

            meta(name='description', content='[[*seodescription:empty=`[[*longtitle]]`]]')
            meta(name='keywords', content='[[*seokeywords]]')
            meta(property='og:image', content='[[++site_url]]assets/css/img/ogimage.png')
