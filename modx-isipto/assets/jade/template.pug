mixin crumbs()
    | [[pdoCrumbs?
    | &tplWrapper = `@CODE <div class="breadcrumbs"><div class="crumbs"> [[+output]] </div></div>`
    | &tplHome = `@CODE <a href="[[+link]]"><span>Главная</span></a>`
    | &tpl = `@CODE <a href="[[+link]]"><span>[[+menutitle]]</span></a>`
    | &tplCurrent = `@CODE <span>[[+menutitle]]</span>`
    | &outputSeparator = ``
    | &showHome=`1`
    | &showCurrent=`1`
    | ]]



