                        .list-icon.d-flex
                            .list-icon__icon.d-md-flex.d-none.justify-content-center.align-items-center
                                svg(xmlns="http://www.w3.org/2000/svg")
                                    use(xlink:href="/assets/css/img/type_jobs/geodez/sprite.svg#complex4")
