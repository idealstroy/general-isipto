@import 'nib'
@import 'rupture'

/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Адаптив*/
rupture.scale =       0    576px    767.98px    992px    1200px
rupture.scale-names =  'xs'     'sm'     'md'     'lg'      'xl'

.first-screen
  margin-top 110px
  padding 0 0 50px
  background url('img/tenders/first-screen.jpg') #f4f4f4 right/cover no-repeat
  background-position 25% 100%
  +below(lg)
    background-position 50% 100%
  +below(md)
    margin-top 0
    background #f4f4f4
  &__item
    margin-bottom 15px
  &__item-icon
    width 35px
    margin-right 15px
    svg
      fill #D34841
  &__item-text
    font-size rem(18px)
    line-height rem(25px)

.participate
  padding rem(60px 0)
  &__title
    height 225px
    font-weight bold
    font-size rem(36px)
    line-height rem(49px)
    +below(md)
      height auto
      padding-bottom 30px
  &__list-item-number
    size 64px
    flex none
    font-size rem(25px)
    line-height rem(34px)
    background #FFCCCA
    border-radius 100%
  &__list-item-text
    font-weight 600
    margin-left 25px
    font-size rem(21px)
    line-height rem(29px)
  &__list-item
    position relative
    +below(md)
      padding-bottom 25px
    &:first-child:after, &:last-child:after
      position absolute
      left -155px
      top 0
      content ''
      width 100px
      height 1px
      background #eaeaea
      +below(lg)
        top 10px
        left -110px
      +below(md)
        display none
    &:first-child:after
      top 70px
      transform rotate(-18deg)
    &:last-child:after
      transform rotate(18deg)

.tenders-sites
  &__item-box
    width 25%
    padding 15px
    margin-bottom 60px
    +below(sm)
      width 33.3333%
    +below(xs)
      width 50%
  &__item
    max-width 100%


.list-icon
  margin-bottom rem(40px)
  &__icon
    size 65px
    flex none
    margin-right 30px
    border-radius 100%
    background #ECF3F5
    svg
      size 33px 38px
      fill #D34841
  &__content
    font-size rem(18px)
    line-height rem(25px)
  &__title
    font-weight bold
    margin-bottom 15px

.invite
  .title
    margin-bottom 10px
  &__subtitle
    font-weight 300
    font-size  rem(30px)
    line-height  rem(41px)
    margin-bottom rem(30px)
    +below(sm)
      font-size  rem(22px)
      line-height  rem(27px)
  &__item-right
    size 160px

.work-with-us
  position relative
  margin-top rem(80px)
  padding 20px 60px
  background #f5f6f7
  border-radius 10px
  +below(md)
    padding 20px 15px
  &:after
    position absolute
    right 10px
    bottom 0
    content ''
    size 350px 205px
    background url('img/tenders/Intersect.svg') right/cover no-repeat
    +below(xs)
      display none
  &__title
    font-weight bold
    font-size rem(36px)
    line-height rem(49px)
    margin-bottom rem(40px)
  &__item
    position relative
    z-index 1
    margin-bottom 20px
  &__icon-box
    size 55px
    flex none
    border-radius 100%
    background #D34841
    margin-right 25px
  &__icon
    size 25px
    fill #fff
  &__text
    font-size rem(20px)
    line-height rem(27px)