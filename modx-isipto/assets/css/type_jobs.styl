@import 'nib'
@import 'rupture'

/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Адаптив*/
rupture.scale =       0    576px    767.98px    992px    1200px
rupture.scale-names =  'xs'     'sm'     'md'     'lg'      'xl'

.first-screen-type-jobs
  background url('img/ppr/first-screen.jpg') center/cover no-repeat
  +below(xs)
    background-position 35% 50%

.ppr-vantages
  margin-top rem(50px)
  &__item
    margin-bottom rem(20px)
    &:last-child
      margin-bottom 0
  &__icon
    size 38px
    fill #D34841
    margin-right 20px
  &__text
    font-size rem(24px)
    line-height rem(33px)
    span
      font-weight bold

.first-screen-form
  margin-top 40px
  &__title
    font-size 16px
    line-height 22px
    margin-bottom 15px
  &__input
    width 211px
    border none
    padding 14px 10px
    background #F6F7F8
    +below(xs)
      width 100%
    &:focus
      background #fff

.first-screen-info
  &__button
    margin-left 15px
    +below(xs)
      width 100%
      margin 15px 0 0

.info-document
  font-size 15px
  line-height 20px
  padding-bottom rem(25px)
  .title_services
    padding 0 0 15px
  &__subtitle
    font-size 18px
    line-height 25px

.info-document-item
  &:first-child
    padding-top rem(40px)
  &__img img
    margin auto
    max-width 100%
  &__title
    font-weight bold
    font-size 18px
    line-height 25px
    margin 25px 0 15px
    +below(sm)
      margin-top 15px
  ul
    li
      padding 5px 0
      &:before
        top 11px
  &__content-bottom
    padding-top rem(30px)

.second-type
  &__img
    max-width 100%
    +below(md)
      width 160px
      margin auto
      display block
    +below(sm)
      width 100px
  &__title
    +below(sm)
      margin-bottom 0
      padding-left 20px
  &__text
    color #333333
    font-size 15px
    line-height 25px
    +below(sm)
      margin-top 25px

.list-document-new
  +below(md)
    position relative
    padding 25px 0
    background #F6F7F8
  &__title
    +below(md)
      width 87%
  &__ul-box
    position relative
    column-count 2
    padding 30px 40px
    border-radius 6px
    background #F6F7F8
    box-shadow 0 0 20px rgba(0, 0, 0, 0.15)
    +below(md)
      position static
      background none
      box-shadow none
      column-count 1
      padding 0 10px
  &__ul
    margin 0
  &__icon-box
    position absolute
    padding 12px
    top 5px
    right 15px
    width 45px
    height 45px
    background #FFFFFF
    border-radius 10px
  &__icon
    width 22px
    height 24px

.complex
  overflow hidden
  padding-top rem(35px)
  &__video-title
    width 100%
    margin 20px 0
    padding 0 15px
    text-align center
    font-weight normal
    font-size 1.875rem
    line-height 2.5625rem
  &__fio
    font-weight bold
    font-size 14px
    line-height 16px
    margin-top 10px
  &__proffess
    color #616161
    font-size 12px
    line-height 14px
    font-weight normal
  &__subtitle
    margin-top 30px
    font-weight bold
    font-size rem(22px)
    line-height rem(30px)
  &__text
    column-count 2
    margin-top 15px
    font-size rem(18px)
    line-height rem(25px)
    +below(xs)
      column-count 1
  &__icon
    size 130px 20px
    display block
    margin-top 15px
  &__doing-title
    margin rem(20px 0)
    font-size rem(30px)
    line-height rem(41px)
  &__item-right svg
    size 163px 173px
  &__result
    position relative
    background #DCE2E4
    padding rem(40px 15px 20px)
    &:before
      content ''
      position absolute
      top 0
      left calc(50% - 20px)
      width 0
      height 0
      border-top 25px solid #FFFFFF
      border-left 20px solid transparent
      border-right 20px solid transparent
    span
      color #D34841
  &__result-icon
    text-align center
    svg
      size 47px 53px
  &__result-text
    font-size rem(22px)
    line-height rem(30px)
    font-weight bold
    text-align center
    margin 10px auto 0

.list-icon
  margin-bottom rem(40px)
  &__icon
    size 65px
    flex none
    margin-right 30px
    border-radius 100%
    background #ECF3F5
    +below(md)
      margin-right 15px
    svg
      size 30px 33px
      fill #D34841
  &__content
    font-size rem(18px)
    line-height rem(25px)
  &__title
    font-weight bold
    margin-bottom 15px
    +below(md)
      margin 0
  &__text
    +below(md)
      margin-top 15px

.sheme-works
  &__box
    margin-left 15px
  &__item
    position relative
    padding-bottom 70px
    padding-left 41px
    background url('img/type_jobs/geodez/sheme-works-line.svg') left/auto repeat-y
    +below(xs)
      padding-bottom 40px
    &:last-child
      padding-bottom 0
      background none
    &:last-child:before
      position absolute
      content ''
      top -14px
      left -5px
      border 5px solid transparent
      border-top 5px solid rgb(220, 220, 220)
      +below(sm)
        top -10px
        left -5px
        border 6px solid transparent
        border-top 5px solid rgb(220, 220, 220)
    &:after
      position absolute
      top -5px
      left -13px
      content ''
      size 26px
      background url('img/type_jobs/geodez/sheme-works-circle.png') left/auto repeat-y
  &__item-title
    color #333333
    font-weight bold
    font-size 15px
    line-height 20px
    margin-bottom 8px
  &__item-text
    color #777777
    font-size 15px
    line-height 20px

