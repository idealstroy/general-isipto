@import 'nib'
@import 'rupture'

/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Адаптив*/
rupture.scale =       0    576px    767.98px    992px    1200px
rupture.scale-names =  'xs'     'sm'     'md'     'lg'      'xl'

.first-screen-blog
  padding 0
  margin-top 110px
  padding-bottom 3.125rem
  background url('img/blog/first-screen.jpg') center/cover no-repeat
  +below(md)
    margin 0
  &__title
    font-weight bold
    margin-bottom 10px
    font-size rem(36px)
    line-height rem(42px)
  &__subtitle
    font-size rem(24px)
    line-height rem(33px)

.blog-box
  padding-top rem(50px)

.blog-item
  margin-bottom 40px
  +below(xs)
    margin-bottom 50px
  &__img img
    margin auto
    max-width 100%
    border-radius 4px
  &__date-icon
    font-size 12px
    line-height 12px
  &__date-box
    margin-top 10px
  &__date-icon svg
    size 13px
    margin-right 6px
  &__date-text
    color #616161
    font-size 12px
    line-height 16px
  &__title
    font-size 18px
    line-height 25px
    font-weight bold
    margin 20px 0 10px
    a
      color #000
      border-bottom 1px solid transparent
      &:hover
        border-bottom 1px solid #000
  &__content
    font-size 12px
    line-height 16px
    color #616161
    p:last-child
      display inline
      margin-right 10px
  &__text-moreinfo
    display inline
    color #D34841
    font-size 12px
    line-height 16px
    border-bottom 1px solid transparent
    &:hover
      color #D34841
      border-bottom 1px solid #D34841
  &__signature
    color #fff
    padding 2px 15px
    border-radius 2px
    background #D34841
    margin-right 15px

.pagination
  margin-top rem(30px)!important
.page-item
  &:before
    display none
.page-item a
  color #000
  transition .3s
  font-size 15px
  line-height 20px
  background #E1E1E1
  border 1px solid
  border-color #e1e1e1 !important
.page-item.disabled a
  border 1px solid
  border-color #e1e1e1 !important


.page-item.active a, .page-item a:hover
  color #ffffff!important
  border-color #D34841!important
  background-color #D34841!important

.blog
  padding-bottom rem(25px)
  &__img
    margin-bottom 20px
    img
      width 100%
      border-radius 7px
  &__content
    margin auto
  &__title
    font-weight 300
    font-size 36px
    line-height 49px
    text-align center
    margin 20px 0 10px
  &__content-article-icon svg
    size 14px 15px
    margin 7px 7px 0 0
  &__content-info
    margin-bottom 30px
  &__content-article-box:last-child &__content-article-text
    margin-right 0
    padding-right 0
    border-right 0
  &__content-article-text
    color #616161
    font-size 14px
    line-height 14px
    margin-right 30px
    padding-right 30px
    border-right 0.5px solid #CECECE
  &__text
    color #616161
    font-size 15px
    line-height 25px
    a
      color #f24941
    p
      margin-bottom 15px
    &_left
      display block
      margin-left 70px
      +below(md)
        margin 0
    em
      display block
      margin-left 70px
      +below(md)
        margin 0
  h1, h2, h3, h4, h5, h6
    margin 20px 0