@import 'nib'
@import 'rupture'

/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Адаптив*/
rupture.scale =       0    576px    767.98px    992px    1200px
rupture.scale-names =  'xs'     'sm'     'md'     'lg'      'xl'

.first-screen
  background #f6f7f9

.first-screen-left
  &__subtitle
    font-size 1rem
    font-weight 400
    line-height 1.375rem

.first-screen-right
  &__price
    margin 0 auto
    color #0d0d0d
    font-weight 400
    font-size 1.875rem
    margin-bottom 10px

.develop-item
  height 300px
  cursor pointer
  +below(lg)
    height auto
    margin-bottom 30px
  &:hover
    .develop-button
      color #fff
      background #f24941
  &__caption
    color #000
    font-weight 700
    font-size 1.5rem
    line-height 1.625rem
  &__content
    color #707e82
    margin 15px 0
    font-weight 400
    font-size 0.875rem
.develop-button
  color #000
  width 230px
  margin 0 auto
  cursor pointer
  font-size 1rem
  font-weight 600
  padding 8px 25px
  text-align center
  border-radius 30px
  border 1px dashed #f24941
  &:hover
    color #fff
    background #f24941

.vantages
  padding-bottom rem(60px)
  background-color #eef4f8
  border-bottom 1px solid #d0d5da
  .container
    max-width 1200px

.vantages-item
  padding rem(25px)
  background-color #fff
  border 1px solid #d7dfe4
  +below(xs)
    padding 15px
  &__svg svg
    width 60px
    height 50px
    fill #dd5b51
    margin-right 15px
  &__caption
    font-weight 600
    margin-bottom 5px
    font-size rem(18px)
    line-height rem(23px)
  &__text
    color #666666
    font-weight 400
    font-size rem(16px)
    line-height rem(21px)

.who-audit
  background #f3f3f3
  padding-bottom rem(60px)

.who-audit-content
  padding 25px
  background #fff
  &__title
    font-weight 700
    font-size 1.5rem
    line-height 1.75rem
  &__svg svg
    size 25px
  &__text
    color #707e82
    margin 25px 0
    font-weight 400
    font-size 0.875rem
    line-height 1.125rem

.who-audit-item__signature
  color #616161
  margin 10px 0
  font-size 1rem
  font-weight 400
  text-align center
  line-height 1.75rem
  span
    transition .3s
    padding-bottom 3px
    border-bottom 1px dashed #616161
    &:hover
      border-bottom 1px dashed transparent

.who-audit-content__button
  color #000
  width 100%

.answers
  background url('img/techaudit/answers.jpg') no-repeat center / cover

.answers-item
  padding 25px
  height 165px
  margin-bottom rem(30px)
  background-color #fff
  +below(sm)
    height auto
  &__svg svg
    size 35px
    margin-right 15px
  &__title
    font-weight 600
    font-size 1.125rem
    line-height 1.5rem
    margin-bottom 10px
  &__text
    font-weight 400
    font-size 0.875rem
    line-height 1.375rem

.analysis
  background #f3f3f3
  padding-bottom rem(60px)

.what-works
  background #dbe2e4
  padding-bottom rem(30px)

.what-works-item
  padding 25px
  background #fff
  margin-bottom rem(30px)
  &__text
    font-weight 600
    font-size 1.375rem
    line-height 1.75rem
  &__svg svg
    size 35px

.result-box
  padding 25px 45px
  background #ffffff
  &__svg
    size 80px 90px
  &__svg-icon
    svg
      size 40px
  &__title
    font-weight 700
    margin-bottom 25px
    font-size 1.875rem
    line-height 2.2rem



