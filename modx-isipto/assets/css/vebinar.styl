/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Изменение цвета аттрибута placeholder*/
placeholder(color)
  &::-webkit-input-placeholder
    color #c7c7c8
  &::-moz-placeholder
    color #c7c7c8
  &:-ms-input-placeholder
    color #c7c7c8
  &::placeholder
    color #c7c7c8

/*Адаптив*/
rupture.scale =       0    576px    767.98px    992px    1200px
rupture.scale-names =  'xs'     'sm'     'md'     'lg'      'xl'

.vebinar
  margin-top 120px
  padding-bottom rem(50px)
  min-height calc(100vh - 178px)
  +below(md)
    margin-top 0
  iframe
    position absolute
    top 0
    bottom 0
    width 100%
    +below(md)
      position unset

.vebinar-item
  margin-top rem(45px)
  padding-top rem(30px)
  border-top 1px solid #e0e0e0
  &__content
    font-size 14px
    line-height 21px
    +below(md)
      margin-top 15px
  ul li
    padding 0
    &:before
      top 6px
  &__title
    font-size 22px
    line-height 30px
    font-weight bold
  &__date
    font-size 13px
    margin-bottom 20px
  &__button
    color #fff
    font-weight 500
    font-size 1.1rem
    padding 10px 16px
    background #c80017
    display inline-block
    text-transform uppercase
    &:hover
      color #fff


.breadcrumbs
  position relative
  z-index 1
  padding 30px 0
.crumbs
  color #737373
  font-weight 400
  font-size rem(16px)
  line-height rem(30px)
  a
    color #fff
  a
    span
      color #737373
      border-bottom 1px solid #b0b0b0
      &:hover
        border-bottom 1px solid transparent
    &:after
      color #a6a6a6
      content "/"
      padding 0 12px
      display inline-block

.inner__title
  margin 0
  font-size 1.875rem
  font-weight 800
  margin-bottom 2.1875rem
  line-height 1.875rem

.vebinar-video-box
  height 340px
  +below(md)
    height 100%