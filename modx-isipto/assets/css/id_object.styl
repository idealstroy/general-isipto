.process
  &__icon
    size 77px 84px
    +below(md)
      width 130px
    +below(sm)
      width 155px
    +below(xs)
      display none
  &__list
    padding-left 70px
    font-size rem(18px)
    margin 50px 0 0 15px
    background url("img/process.png") left/contain no-repeat;
    +below(xs)
      margin 0
      background none
      padding-left 20px
  &__list-item
    padding 15px 0
    position relative
    &:last-child
      padding-bottom 0
    &:before
      content ''
      position absolute
      top 20px
      left -38px
      size 12px
      background #F29A95
      border-radius 100%
      box-sizing border-box
      border 2px solid #FFFFFF
      +below(lg)
        left -35px
      +below(md)
        left -27px
      +below(sm)
        left -20px

.services
  background #ffffff

.services-item-left
  width 33%
  +below(sm)
    width 100%

.services-item:first-child
  border-radius 7px 7px 0 0

.services-item:last-child
  border-radius 0 0 7px 7px

.services-item
  width 100%
  padding 13px 0
  background-color #fff
  border-bottom 1px solid #e8e8e8
  +below(sm)
    flex-wrap wrap
    padding 13px 15px
    text-align center
  &__caption-text
    width 50%
    font-size 22px
    line-height 26px
  .services-item-left
    .services-item__caption-text
      width 100%
  &__caption
    color #000
    font-weight 600
    font-size 17px
  &__price
    font-size 15px
    font-weight 400
    margin-left 30px
    text-align center
    +below(sm)
      width 100%
    +below(374px)
      font-size 14px
    span
      font-size 1.11rem

.services-item-right
  width 67%
  +below(sm)
    width 100%
    margin-top 20px
  .services-item-button
    color #000
    transition .3s
    padding 5px 25px
    border-radius 3px
    background #ec767524
    +below(xs)
      width 100%
      justify-content center
    &__text
      font-size 15px
      line-height 20px
      +below(sm)
        text-align center
    &:hover
      color #fff
      background-color #E03B32

.services-item-right
  .services-item-button-box
    +below(sm)
      display none
  .services-item-moreinfo
    color #000
    transition .3s
    padding 5px 15px
    margin-left 15px
    border-radius 30px
    background #f5f5f6
    border 1px solid rgba(186, 192, 200, 0.3)
    +below(md)
      display none!important
    +below(xs)
      display flex!important
    +below(374px)
      width 100%
      border none
      margin-left 0
      background transparent
    &__text
      margin 0 auto
    &__svg svg
      size 15px
      fill #bac0c8
      margin-left 12px
      +below(374px)
        display none
    &:hover
      color #fff
      background-color #bac0c8
      .services-item-moreinfo__svg svg
        fill #fff

.services-text
  margin rem(40px 0)