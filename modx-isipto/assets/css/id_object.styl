@import 'nib'
@import 'rupture'

/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Адаптив*/
rupture.scale =       0    576px    767.98px    992px    1200px
rupture.scale-names =  'xs'     'sm'     'md'     'lg'      'xl'

.first-screen
  background url('img/id-object/first-screen.png') #f4f4f4 right/auto no-repeat
  background-position: 80% 100%;
  +below(lg)
    background-position 510px 50%

.list-icon
  margin-bottom rem(40px)
  &__icon
    size 65px
    flex none
    margin-right 30px
    border-radius 100%
    background #ECF3F5
    svg
      size 33px 38px
      fill #D34841
  &__content
    font-size rem(18px)
    line-height rem(25px)
  &__title
    font-weight bold
    margin-bottom 15px

.productivity
  &__box
    padding 30px 50px
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    +below(md)
      padding 20px 15px
  &__box_bg-right
    background url("img/id-object/productivity1.jpg") right bottom/auto no-repeat
    +below(lg)
      background-position: 106% 100%;
    +below(md)
      background none
  &__title
    color #333333
    font-size 18px
    line-height 27px
    margin-bottom 8px
  &__text
    color #777777
    font-size 15px
    line-height 27px
    margin-bottom 0
  &__text_dark
    color #333333
  &__img
    margin -30px 50px -30px 0
    +below(md)
      display none


