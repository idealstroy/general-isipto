@import 'nib'
@import 'rupture'


/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Адаптив*/
rupture.scale =       0    576px    767.98px    992px    1200px
rupture.scale-names =  'xs'     'sm'     'md'     'lg'      'xl'


.about-company-inner
  position relative
  background url('img/about_company/first-screen.jpg') center/cover no-repeat
  +below(xs)
    background-position 35% 50%
  &__button
    color #fff
  &__title
    color #2e2e2e
    font-weight 700
    font-size 2.25rem
    margin-bottom 40px
    line-height 2.95rem
  &__subtitle
    font-size 20px
    line-height 27px
    font-weight bold
    margin-bottom 15px
  &__content
    position relative
    z-index 1
  .breadcrumbs
    top 0
    position absolute
  .crumbs
    span
      color #000
    a span
      color #000
  &__img
    background url('img/about_company/logo.png') right/contain no-repeat

.about-company-docs
  color #fff
  padding 30px 0 40px
  background url('img/about_company/bg.jpg') center/cover no-repeat
  &__item
    width 50%
    padding 0 7px
    text-align center
    .img_docs-box
      height auto
  &__signature
    width: 100%;
    text-align center
    font-size 18px
    line-height 24px
    +below(sm)
      margin-bottom 25px

.about-company-inner__button
  color #fff

.about-company-vantages
  margin-top -55px
  +below(sm)
    margin-top -25px
  .vantages-item
    padding 1.5625rem
    background-color #fff
    border 1px solid #d7dfe4
    &__svg svg
      size 60px
      margin-right 15px
    &__title
      font-weight 600
      font-size 1.125rem
    &__text
      color #666666
      font-size 1rem
      font-weight 400

.about-company-vantages, .your-department
  background #f4f4f4

.your-department
  &__title
    font-weight 600
    line-height 2rem
    font-size 1.875rem
    margin-bottom 30px
  &__subtitle
    font-weight 400
    line-height 2rem
    font-size 1.375rem
    margin-bottom 30px
  img
    width 100%

.industry-item
  padding 20px
  margin-bottom 30px
  border 1px dashed #f1b8bd
  &__svg svg
    size 55px
    fill #dd5b51
    margin-right 15px
  &__text
    font-weight 600
    font-size rem(16px)
    line-height rem(22px)
    +below(md)
