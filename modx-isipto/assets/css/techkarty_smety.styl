.hint_city
  background #fff
  border 1px solid #bfbfbf
  border-radius 5px
  box-shadow 0 0 30px rgba(0, 0, 0, 0.3)
  margin 20px 0 0
  position absolute
  width 187px
  z-index 10
  display none
  +below(sm)
    display none

  .hint_city_content
    font-size 14px
    line-height 22px
    display block
    min-height 25px
    padding 7px 20px 5px

  .hint_button
    text-align center
    margin 2px 0 10px

  .button_small
    height 24px
    cursor pointer
    border-top 1px solid #dddddd
    border-right 1px solid #c2c2c2
    border-bottom 1px solid #a3a3a3
    border-left 1px solid #c2c2c2
    box-shadow 0 1px 0 #dbdbdb
    font-size 13px
    line-height 24px
    white-space nowrap
    display inline-block
    padding 0 13px
    border-radius 5px
    background-color #f2f2f2
    background-image linear-gradient(to bottom, #ffffff, #dedede)
    color #303030
    text-shadow 0 1px #fff
    font-weight bold
    -webkit-user-select none
    -moz-user-select none
    -ms-user-select none
    user-select none
    text-decoration none

    &:hover
      color #f24941

  .cityselect
    font-size 13px
    line-height 24px
    margin 0 0 0 15px

  .corner
    position absolute
    top -14px
    left 0
    width 30px
    height 14px
    margin 0 42%

    &:before
      left 0
      top 0
      content ''
      display: block;
      position: absolute;
      border-style: solid;
      height: 0;
      width: 0;
      border-width 0 15px 14px 15px
      border-color #b3b2b2 rgba(255, 255, 255, 0)

    &:after
      @extend .hint_city .corner:before
      left 1px
      top 1px
      content ''
      border-width 0 14px 13px 14px
      border-color #fff rgba(255, 255, 255, 0)

