/*Зачарование пикселей в ремы*/
rem() {
  remified = ()
  for arg in arguments {
    push(remified, unit(arg/16, 'rem'))
  }
  return remified
}

/*Изменение цвета аттрибута placeholder*/
placeholder(color)
  &::-webkit-input-placeholder
    color #c7c7c8
  &::-moz-placeholder
    color #c7c7c8
  &:-ms-input-placeholder
    color #c7c7c8
  &::placeholder
    color #c7c7c8

