extends ../layout/default.pug
block append var
    -var index = true
block content
    .first-screen.bg.first-screen-idealstroiinvest(style="background-image: url('../dist/img/idealstroyinvest/bg1.jpg')")
        .container
            .row
                .first-screen__content.col-lg-10.col-12
                    .first-screen__title Брендинг и маркетинг для строительной компании
                    .first-screen__subtitle Задача организации, в особенности же постоянное информационное и пропагандистское обеспечение.
                    .first-screen__text Над проектом работали
                    .d-flex.justify-content-center
                .bg-item__content.col-xl-5.col-lg-6.col-md-6.col-12
                    .bg-item__title Задача
                    .bg-item__text Разнообразный и богатый опыт постоянный количественный рост и сфера нашей активности в значительной степени обуславливает создание форм развития.

    .bg-item
        .container
            .row
        .bg(style="background-image: url('../dist/img/idealstroyinvest/bg2.jpg')")
    .bg-item
        .container
            .row
                .bg-item__content.col-lg-6.col-md-9.col-12
                    .bg-item__title Брендинг
                    .bg-item__text Разнообразный и богатый опыт постоянный количественный рост и сфера нашей активности в значительной степени обуславливает создание форм развития.
        .bg(style="background-image: url('../dist/img/idealstroyinvest/bg3.jpg')")

    .bg-item.bg-item-idealstroiinvest
        .container
            .bg-item__content
                .bg-item__title Брендинг
                .row
                    .col-md-6.col-12
                        .bg-item__text Разнообразный и богатый опыт постоянный количественный рост и сфера нашей активности в значительной степени обуславливает создание форм развития.
                    .col-md-6.col-12
                        .bg-item__text Разнообразный и богатый опыт постоянный количественный рост и сфера нашей активности в значительной степени обуславливает создание форм развития.
            .bg.bg-idealstroiinvest(style="background-image: url('../dist/img/idealstroyinvest/bg4.jpg')")
                .text-idealstroiinvest.col-md-4.col-12
                    .text-idealstroiinvest-item
                        .text-idealstroiinvest-item__title 11 одностраничников
                        .text-idealstroiinvest-item__text в связке с сервисом Yagla для подстройки заголовков и увеличения конверсии
                    .text-idealstroiinvest-item
                        .text-idealstroiinvest-item__title 1 основной сайт
                        .text-idealstroiinvest-item__text для естесственного продвижения в поисковых системах и в качестве носителя основного контента

    .bg-item.item-idealstroiinvest-marketing
        .container
            .row
                .bg-item__content.col-lg-6.col-12
                    .bg-item__title Маркетинг
                    .bg-item__text Разнообразный и богатый опыт постоянный количественный рост и сфера нашей активности в значительной степени обуславливает создание форм развития.

                .bg-item__content.d-flex.col-lg-6.col-12
                    div
                        svg
                            use(href='../dist/img/idealstroyinvest/checkmark.svg#checkmark')
                    div
                        .bg-item__title Увеличили количество заявок в 10 раз
                        .bg-item__text при этом, затраты на маркетинг увеличились всего в 2 раза
            img(src="../dist/img/idealstroyinvest/bg5.jpg" alt="")

            .row
                .bg-item__content.d-flex.col-lg-6.col-12
                    div
                        svg
                            use(href='../dist/img/idealstroyinvest/checkmark.svg#checkmark')
                    div
                        .bg-item__title Подняли конверсию в заявки с 2.28 до 7.59%
                        .bg-item__text максимальные значения в некоторые дни доходили до 29% и 33%
                .bg-item__content.d-flex.col-lg-6.col-12
                    div
                        svg
                            use(href='../dist/img/idealstroyinvest/checkmark.svg#checkmark')
                    div
                        .bg-item__title Конверсия в продажи составляет 25%
                        .bg-item__text максимальные значения в некоторые дни доходили до 80% и 95%